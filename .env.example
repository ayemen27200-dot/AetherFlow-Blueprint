# Copy to .env with: python scripts/init_wizard.py
# Never add production tokens or secrets to Git.
FERNET_KEY=
BEARER_TOKEN=
AGENTS_AUTH_TOKEN=

# Database and server
DATABASE_PATH=./data/aetherflow.db
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Caddy reverse proxy; use a real DNS name and a valid email for production TLS.
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# Optional integrations (leave blank/disabled unless configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
LITELLM_MASTER_KEY=

# D2 local worker (no secrets; paths only). The API only accepts opaque
# upload ids — the worker maps them to files inside AETHERFLOW_UPLOAD_STORE.
AETHERFLOW_DB_PATH=./data/aetherflow.db
AETHERFLOW_UPLOAD_STORE=./data/upload_store
AETHERFLOW_OUTPUT_DIR=./data/outputs
AETHERFLOW_SEGMENT_SECONDS=300
AETHERFLOW_CONCURRENCY=1
AETHERFLOW_POLL_INTERVAL=1.0
AETHERFLOW_MAX_JOBS=-1
AETHERFLOW_LOG_LEVEL=INFO
# Optional explicit binary paths; blank means PATH lookup.
AETHERFLOW_FFMPEG=
AETHERFLOW_FFPROBE=
# Optional override for the transfer contract; containers auto-resolve
# /app/config/file_transfer_spec.yaml via the working-directory fallback.
AETHERFLOW_TRANSFER_SPEC=
# Trusted root for the one-shot local `aetherflow split` command.
AETHERFLOW_ALLOWED_BASE=
