# Multi-stage image for the API/orchestrator scaffold.
# GPU inference is deliberately not bundled in this CPU API image.
FROM python:3.11-slim AS builder

WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY agent ./agent
COPY orchestrator ./orchestrator
COPY executors ./executors
COPY web ./web
COPY scripts ./scripts
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir ".[server,asr,cloud,telegram]"

FROM python:3.11-slim AS runtime
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg sqlite3 curl rsync openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin aetherflow \
    && mkdir -p /app/data /app/config /app/web/templates /app/web/static \
    && chown -R aetherflow:aetherflow /app

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=aetherflow:aetherflow config ./config
COPY --chown=aetherflow:aetherflow web/templates ./web/templates
COPY --chown=aetherflow:aetherflow web/static ./web/static
USER aetherflow
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8000/health >/dev/null || exit 1

# Bind to the container interface; Compose does not publish port 8000 to the host.
CMD ["uvicorn", "orchestrator.main:app", "--host", "0.0.0.0", "--port", "8000"]
